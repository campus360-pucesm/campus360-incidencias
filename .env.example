# Base de Datos (Supabase)
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]
# Ejemplo Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password123@db.ref.supabase.co:5432/postgres

# Supabase Client (Opcional, si se usa la API de Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# JWT Config (Debe coincidir con la configuración de JWT de Supabase si se usa Auth de Supabase)
JWT_SECRET_KEY=your-supabase-jwt-secret
JWT_ALGORITHM=HS256
JWT_AUTH_SERVICE_URL=http://localhost:8000/auth/validate
